<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sonatype.nexus.common.components</groupId>
    <artifactId>nexus-common-components-parent</artifactId>
    <version>3.96.4-01</version>
    <relativePath/>
  </parent>
  <artifactId>nexus-cluster-web</artifactId>
  <name>Nexus optional Kubernetes web adapters</name>
  <properties><maven.compiler.release>25</maven.compiler.release></properties>
  <dependencies>
    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-cluster-api</artifactId>
      <version>${nexus.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-spring</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency><groupId>org.sonatype.nexus.common.components</groupId><artifactId>nexus-rapture</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.sonatype.nexus.common.components</groupId><artifactId>nexus-security</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.sonatype.nexus.common.components</groupId><artifactId>nexus-rest-jackson2</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.sonatype.nexus.common.components</groupId><artifactId>nexus-test-common</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>dev.aspectj</groupId>
    <artifactId>aspectj-maven-plugin</artifactId>
    <configuration><skip>true</skip></configuration>
  </plugin></plugins></build>
</project>
